# Copy to .env.local for development. Never commit real values.

# Public URL of the site (used for canonical links, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact details — each one is hidden from the site until it is set.
# WhatsApp: full international number, digits only (country code first), e.g. 91XXXXXXXXXX
WHATSAPP_NUMBER=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_ADDRESS=

# ---- Shraddha Date Finder (server-only; never exposed to the browser) ----
# Primary Panchang source — free key from https://shubh.live/developers
SHUBH_API_KEY=
# Optional second source for cross-checking the death Tithi — https://www.navamsha.in
NAVAMSHA_API_KEY=
# Set to "true" ONLY after the live fixture test passes and an Acharya has reviewed
# the results (see docs/PANCHANG_PLAN.md). Until then every result is marked
# "priest confirmation needed".
PANCHANG_RESULTS_VERIFIED=
# Local UI testing only: PANCHANG_PROVIDER=synthetic (refused on Vercel/production)
# PANCHANG_PROVIDER=

# ---- Added in later stages ----
# DATABASE_URL=postgresql://user:password@host:5432/pitra_sewa   (Stage 4)
# AUTH_SECRET=                                                    (Stage 4, admin auth)
