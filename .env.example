# Copy to .env.local for development. Never commit real values.

# Public URL of the site (used for canonical links, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact details — each one is hidden from the site until it is set.
# WhatsApp: full international number, digits only (country code first), e.g. 91XXXXXXXXXX
WHATSAPP_NUMBER=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_ADDRESS=

# ---- Shraddha Date Finder ----
# The engine runs in-process and needs NO key. These are optional:
# Cross-check the death Tithi against an external API (server-only keys).
SHUBH_API_KEY=
NAVAMSHA_API_KEY=
# "true" marks every result "priest confirmation needed" (e.g. during an Acharya review).
PANCHANG_REQUIRE_REVIEW=

# ---- Added in later stages ----
# DATABASE_URL=postgresql://user:password@host:5432/pitra_sewa   (Stage 4)
# AUTH_SECRET=                                                    (Stage 4, admin auth)
