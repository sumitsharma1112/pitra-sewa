# Copy to .env.local for development. Never commit real values.

# Public URL of the site (used for canonical links, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact details — each one is hidden from the site until it is set.
# WhatsApp: full international number, digits only (country code first), e.g. 91XXXXXXXXXX
WHATSAPP_NUMBER=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_ADDRESS=

